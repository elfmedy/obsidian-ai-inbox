{
  "name": "ai-inbox",
  "version": "0.3.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint spikes --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:p0": "node scripts/build-p0.mjs",
    "build:alpha": "node scripts/build-alpha.mjs",
    "prepare:p0": "npm run build:p0 && node scripts/prepare-p0-vault.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:p0 && node scripts/check-package.mjs && npm run build:alpha && node scripts/check-alpha.mjs",
    "build": "npm run build:alpha"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "zod": "4.6.2"
  }
}
